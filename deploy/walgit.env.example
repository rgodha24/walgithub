# Environment shared by both services in deploy/compose.yaml.
#
#   cp deploy/walgit.env.example deploy/.env
#   "${EDITOR:-vi}" deploy/.env
#   docker compose -f deploy/compose.yaml up -d --build
#
# Compose loads `.env` for ${…} interpolation and passes it to both containers as environment.
# `WALGIT__SECTION__KEY` overrides deploy/host.toml or deploy/walgithub.toml. Guidance:
# docs/HOSTING.md.

# ---- object store (you provide it; this stack starts no store) ------------------------------
WALGIT__STORE__BUCKET=
WALGIT__STORE__S3__REGION=us-east-1
# For an S3-compatible endpoint (MinIO, rustfs, R2, Ceph). Empty = the AWS endpoint for the region.
# The optional deploy/compose.rustfs.yaml publishes one on the host; see docs/HOSTING.md §3.
# WALGIT__STORE__S3__ENDPOINT=http://host.docker.internal:9000
# WALGIT__STORE__S3__FORCE_PATH_STYLE=true
# Credentials: leave both unset to use the instance/task role (D43). If you need a static pair,
# set BOTH; one alone fails closed.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- WAL-Git (:8080) ------------------------------------------------------------------------
# Bearer for the admin principal. Generate one: openssl rand -hex 32
WALGIT_TOKEN=
# token (default) or oidc. The facade is always auth-free and is not affected by this.
# WALGIT_AUTH_MODE=token
WALGIT_PUBLIC_URL=http://127.0.0.1:8080
WALGIT_PORT=8080
WALGIT_LISTEN=0.0.0.0:8080
WALGIT_CONTAINER_PORT=8080

# ---- WAL-Github (:8097) ---------------------------------------------------------------------
# The GHES facade is auth-free; keep it on loopback or a private network (docs/GITHUB.md).
WALGITHUB_PUBLIC_URL=http://127.0.0.1:8097
WALGITHUB_PORT=8097
WALGITHUB_LISTEN=0.0.0.0:8097
WALGITHUB_CONTAINER_PORT=8097
# Keep this loopback: the facade is auth-free. It does not follow WALGIT_BIND.
WALGITHUB_BIND=127.0.0.1

# ---- both -----------------------------------------------------------------------------------
# Only publish beyond loopback behind a firewall or on a private network.
WALGIT_BIND=127.0.0.1
# Optional prebuilt images instead of building this checkout.
# WALGIT_IMAGE=registry.example.com/walgit:latest
# WALGITHUB_IMAGE=registry.example.com/walgithub:latest
